+static int smb5_set_fast_charge_current(struct smb5_chip *chip,
+					unsigned int current_ua)
+{
+	unsigned int val = current_ua / CURRENT_SCALE_FACTOR;
+	int rc;
+
+	rc = regmap_write(chip->regmap, chip->base + FAST_CHARGE_CURRENT_CFG,
+			  val);
+	if (rc < 0)
+		dev_err(chip->dev,
+			"Couldn't set fast-charge current %u uA rc=%d\n",
+			current_ua, rc);
+	return rc;
+}
+
+static void smb5_update_fast_charge_current(struct smb5_chip *chip)
+{
+	unsigned int fcc_ua = DEFAULT_FAST_CHARGE_CURRENT_UA;
+	int usb_uv = 0;
+	int rc;
+
+	/*
+	 * Read VBUS directly instead of going through smb5_get_iio_chan():
+	 * that helper reports 0 while the charger state machine is not in
+	 * CHARGING state (transient during APSD/PD re-negotiation), which
+	 * would make us drop back to the 1.5 A default right after raising it.
+	 */
+	if (IS_ERR(chip->usb_in_v_chan))
+		return;
+
+	rc = iio_read_channel_processed(chip->usb_in_v_chan, &usb_uv);
+	if (rc < 0 || usb_uv == 0)
+		return;
+
+	if (usb_uv >= HIGH_VOLTAGE_THRESHOLD_UV)
+		fcc_ua = HIGH_VOLTAGE_FAST_CHARGE_CURRENT_UA;
+
+	if (fcc_ua == chip->fcc_ua)
+		return;
+
+	rc = smb5_set_fast_charge_current(chip, fcc_ua);
+	if (rc < 0)
+		return;
+
+	chip->fcc_ua = fcc_ua;
+	dev_info(chip->dev,
+		 "fast-charge current set to %u uA (usb %u uV)\n",
+		 fcc_ua, usb_uv);
+}
+
+static void smb5_fcc_work(struct work_struct *work)
+{
+	struct smb5_chip *chip = container_of(work, struct smb5_chip,
+					      fcc_work.work);
+
+	smb5_update_fast_charge_current(chip);
+}
