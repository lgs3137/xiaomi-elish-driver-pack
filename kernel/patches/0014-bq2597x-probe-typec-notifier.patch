+
+static void bq2597x_apply_charge(struct bq2597x *bq, bool enable)
+{
+	int ret;
+
+	if (bq->skip_writes)
+		return;
+
+	ret = bq2597x_enable_charge(bq, enable);
+	if (ret)
+		bq_err("failed to %s charge: %d\n",
+		       enable ? "enable" : "disable", ret);
+	bq2597x_check_charge_enabled(bq, &bq->charge_enabled);
+	bq_info("%s charge (CHG_EN=%d)\n", enable ? "enable" : "disable",
+		bq->charge_enabled);
+}
+
+static void bq2597x_charge_work(struct work_struct *work)
+{
+	struct bq2597x *bq = container_of(work, struct bq2597x,
+					  charge_work.work);
+
+	bq2597x_apply_charge(bq, bq->usb_present);
+}
+
+static int bq2597x_get_typec_psy(struct bq2597x *bq)
+{
+	union power_supply_propval propval;
+
+	if (bq->typec_psy)
+		return 0;
+
+	bq->typec_psy = power_supply_get_by_name(
+		"tcpm-source-psy-c440000.spmi:pmic@2:typec@1500");
+	if (!bq->typec_psy)
+		return -ENODEV;
+
+	bq->nb.notifier_call = bq2597x_notifier_call;
+	if (power_supply_reg_notifier(&bq->nb)) {
+		bq_err("failed to register typec notifier\n");
+		bq->typec_psy = NULL;
+		return -EINVAL;
+	}
+	bq->notifier_registered = true;
+	bq_info("typec psy acquired, notifier registered\n");
+
+	if (!power_supply_get_property(bq->typec_psy, POWER_SUPPLY_PROP_ONLINE,
+				       &propval)) {
+		bq->charge_state = propval.intval;
+		bq->usb_present = !!propval.intval;
+		power_supply_changed(bq->fc2_psy);
+		if (bq->usb_present)
+			schedule_delayed_work(&bq->charge_work,
+					      msecs_to_jiffies(1000));
+	}
+	return 0;
+}
+
+static void bq2597x_psy_work(struct work_struct *work)
+{
+	struct bq2597x *bq = container_of(work, struct bq2597x,
+					  psy_work.work);
+
+	if (bq2597x_get_typec_psy(bq) == 0)
+		return;
+
+	bq->psy_retries++;
+	if (bq->psy_retries < 120)
+		schedule_delayed_work(&bq->psy_work, msecs_to_jiffies(1000));
+	else
+		bq_err("typec psy not found after %d retries\n", bq->psy_retries);
+}
