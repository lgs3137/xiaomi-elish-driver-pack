+/*
+ * The PMIC measures VBAT at its own sense point: while charging at a high
+ * current the IR drop makes it "see" the float/full-on threshold early and
+ * it terminates charging (reported as Full) with the pack only ~80-85% full.
+ * Reduce the fast-charge current step by step while the status registers
+ * report VBATT_GTET_INHIBIT / FULL_ON / TERMINATE, so the CV phase can take
+ * the pack to a real full charge instead of stopping early.
+ */
+static bool smb5_vbat_high(struct smb5_chip *chip)
+{
+	unsigned char stat[2];
+	unsigned int s0;
+	int rc;
+
+	rc = regmap_bulk_read(chip->regmap,
+			      chip->base + BATTERY_CHARGER_STATUS_1, stat, 2);
+	if (rc < 0)
+		return false;
+
+	s0 = stat[0] & BATTERY_CHARGER_STATUS_MASK;
+	if (stat[1] & (VBATT_GTET_INHIBIT_BIT | BATT_GT_FULL_ON_BIT))
+		return true;
+	if (s0 == TERMINATE_CHARGE || s0 == INHIBIT_CHARGE)
+		return true;
+
+	return false;
+}
