+static int smb5_batt_soc(struct smb5_chip *chip)
+{
+	union power_supply_propval v;
+	struct power_supply *psy;
+	int soc = -1;
+
+	psy = power_supply_get_by_name("bq27z561-0");
+	if (!psy)
+		psy = power_supply_get_by_name("bq27z561-1");
+	if (!psy)
+		return -1;
+
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_CAPACITY, &v))
+		soc = v.intval;
+	power_supply_put(psy);
+
+	return soc;
+}
+
+/* step-charging curve: current vs. state of charge (uA) */
+static unsigned int smb5_soc_band_current(int band)
+{
+	static const unsigned int ua[] = {
+		6000000, 4000000, 2500000, 1500000, 1000000, 500000,
+	};
+
+	if (band < 0 || band >= ARRAY_SIZE(ua))
+		return 0;
+	return ua[band];
+}
+
+static int smb5_soc_band(int soc)
+{
+	if (soc < 0)
+		return -1;
+	if (soc < 70)
+		return 0;
+	if (soc < 80)
+		return 1;
+	if (soc < 88)
+		return 2;
+	if (soc < 93)
+		return 3;
+	if (soc < 97)
+		return 4;
+	return 5;
+}
+
+static void smb5_taper_program(struct smb5_chip *chip, unsigned int ua,
+			       const char *why)
+{
+	if (ua < FAST_CHARGE_CURRENT_MIN_UA)
+		ua = FAST_CHARGE_CURRENT_MIN_UA;
+	if (ua > chip->fcc_base)
+		ua = chip->fcc_base;
+	if (ua == chip->fcc_ua)
+		return;
+	if (smb5_set_fast_charge_current(chip, ua))
+		return;
+	chip->fcc_ua = ua;
+	dev_info(chip->dev, "charge %s: fast-charge current -> %u uA\n",
+		 why, ua);
+}
