 /* pmi8150b registers represent current in increments of 1/40th of an amp */
 #define CURRENT_SCALE_FACTOR		50000
+
+/* Fast-charge current (battery side) programmed by this driver.
+ * The PMIC power-on default is only 1.5 A; when a USB-PD charger negotiates
+ * 9 V we can safely raise the battery charge current.  Step is 50 mA.
+ */
+#define DEFAULT_FAST_CHARGE_CURRENT_UA		1500000
+#define HIGH_VOLTAGE_FAST_CHARGE_CURRENT_UA	6000000
+#define HIGH_VOLTAGE_THRESHOLD_UV		6500000
 /* clang-format on */
 
