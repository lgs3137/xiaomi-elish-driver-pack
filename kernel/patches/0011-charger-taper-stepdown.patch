+static void smb5_taper_work(struct work_struct *work)
+{
+	struct smb5_chip *chip = container_of(work, struct smb5_chip,
+					      taper_work.work);
+	unsigned int next;
+	int usb_online = 0;
+
+	smb5_get_prop_usb_online(chip, &usb_online);
+
+	if (!usb_online) {
+		if (chip->fcc_ua) {
+			chip->fcc_ua = 0;
+			smb5_set_fast_charge_current(chip,
+						     DEFAULT_FAST_CHARGE_CURRENT_UA);
+		}
+		goto reschedule;
+	}
+
+	if (!chip->fcc_ua) {
+		smb5_update_fast_charge_current(chip);
+	} else if (smb5_vbat_high(chip)) {
+		next = chip->fcc_ua / 2;
+		if (next < FAST_CHARGE_CURRENT_MIN_UA)
+			next = FAST_CHARGE_CURRENT_MIN_UA;
+		if (next < chip->fcc_ua &&
+		    smb5_set_fast_charge_current(chip, next) == 0) {
+			chip->fcc_ua = next;
+			dev_info(chip->dev,
+				 "charge taper: fast-charge current -> %u uA\n",
+				 next);
+		}
+	}
+
+reschedule:
+	schedule_delayed_work(&chip->taper_work, msecs_to_jiffies(10000));
+}
